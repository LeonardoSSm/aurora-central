{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Permite tela cheia, operações do launcher e preferências tipadas na janela local.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-set-fullscreen",
    "allow-launcher-snapshot",
    "allow-launcher-open",
    "allow-launcher-choose-executable",
    "allow-launcher-remove-executable",
    "allow-launcher-choose-monitor",
    "allow-settings-snapshot",
    "allow-settings-save"
  ]
}
